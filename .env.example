# ==============================================================================
# MojahidX Image Hosting - Environment Variables
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - On Vercel, set these in Project Settings -> Environment Variables.
# - NEVER commit secrets or your actual GITHUB_TOKEN to git repository!
# ==============================================================================

# 1. Target GitHub Repository Configuration (Required)
# The GitHub user or organization that owns the image storage repository.
GITHUB_OWNER=your-github-username

# The repository where images will be stored (default: mojahidx-image-hosting).
GITHUB_REPO=mojahidx-image-hosting

# The branch to commit images to (default: main).
GITHUB_BRANCH=main

# 2. GitHub Personal Access Token (Required - SERVER-SIDE ONLY)
# Create a fine-grained Personal Access Token at:
# https://github.com/settings/personal-access-tokens/new
# Scope: Only select repository -> "mojahidx-image-hosting"
# Permissions: "Contents: Read and write"
# IMPORTANT: Never commit this token or expose it to client code!
GITHUB_TOKEN=github_pat_your_fine_grained_token_here

# 3. Optional Custom Domain / CDN Base URL
# Once you map a custom domain (e.g. img.mojahidx.com) to your Vercel deployment,
# set this variable to generate custom domain image links instead of raw GitHub URLs.
# Leave blank or commented out to use permanent raw GitHub URLs by default:
# https://raw.githubusercontent.com/{owner}/{repo}/{branch}/{path}
PUBLIC_IMAGE_BASE_URL=https://img.mojahidx.com

# 4. Optional Upload & Rate Limiting Controls
# Maximum allowed image upload size in megabytes (default: 5)
MAX_FILE_SIZE_MB=5

# Rate limit: Maximum upload requests per IP within the window (default: 25)
RATE_LIMIT_MAX_REQUESTS=25

# Rate limit window in seconds (default: 600 = 10 minutes)
RATE_LIMIT_WINDOW_SECONDS=600
