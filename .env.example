# ==============================================================================
# MojahidX Image & File Hosting - Environment Variables
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - On Vercel, set these in Project Settings -> Environment Variables.
# - NEVER commit secrets or your actual GITHUB_TOKEN to git repository!
# ==============================================================================

# 1. Target GitHub Repository Configuration (Required)
# The GitHub user or organization that owns the storage repository.
GITHUB_OWNER=your-github-username

# The repository where files will be stored (default: mojahid-img-hosting).
GITHUB_REPO=mojahid-img-hosting

# The branch to commit files to (default: main).
GITHUB_BRANCH=main

# 2. GitHub Personal Access Token (Required - SERVER-SIDE ONLY)
# Create a fine-grained Personal Access Token at:
# https://github.com/settings/personal-access-tokens/new
# Scope: Only select repository -> "mojahid-img-hosting"
# Permissions: "Contents: Read and write"
# IMPORTANT: Never commit this token or expose it to client code!
GITHUB_TOKEN=github_pat_your_fine_grained_token_here

# 3. Personal Vault Access Password
# Password required to access and upload to your private instance.
APP_PASSWORD=Mojahid@1234

# 4. Optional Custom Domain / CDN Base URL
# Once you map a custom domain (e.g. https://img.mojahidx.com) to your Vercel deployment,
# set this variable to generate custom domain links instead of raw GitHub URLs.
PUBLIC_IMAGE_BASE_URL=https://img.mojahidx.com

# 5. Optional Upload & Rate Limiting Controls
# Maximum allowed file upload size in megabytes (default: 100)
MAX_FILE_SIZE_MB=100

# Rate limit: Maximum upload requests per IP within the window (default: 50)
RATE_LIMIT_MAX_REQUESTS=50

# Rate limit window in seconds (default: 600 = 10 minutes)
RATE_LIMIT_WINDOW_SECONDS=600
